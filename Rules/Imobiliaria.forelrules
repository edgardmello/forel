    },
    {
      "id": "aluguel",
      "folderId": "import",
      "name": "Recibo de aluguel",
      "enabled": false,
      "conditionMatch": "all",
      "recursionDepth": null,
      "conditions": [
        { "id": "c1", "ruleId": "aluguel", "kind": "contents", "operator": "matches_regex", "value": "(?i)recibo\\s+de\\s+aluguel" }
      ],
      "actions": [
        { "id": "a1", "ruleId": "aluguel", "kind": "add_tag", "params": { "tags": ["aluguel"] }, "position": 0 }
      ],
      "priority": 6,
      "createdAt": "2026-06-20T00:00:00Z"
    },
    {
      "id": "certidao",
      "folderId": "import",
      "name": "Certidão de ônus",
      "enabled": false,
      "conditionMatch": "all",
      "recursionDepth": null,
      "conditions": [
        { "id": "c1", "ruleId": "certidao", "kind": "contents", "operator": "matches_regex", "value": "(?i)certid[ãa]o\\s+de\\s+([ôo]nus|propriedade|integridade)" }
      ],
      "actions": [
        { "id": "a1", "ruleId": "certidao", "kind": "add_tag", "params": { "tags": ["certidao"] }, "position": 0 }
      ],
      "priority": 7,
      "createdAt": "2026-06-20T00:00:00Z"
    }
  ]
}
