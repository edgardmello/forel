    },
    {
      "id": "contrato-locacao",
      "folderId": "import",
      "name": "Contrato de locação",
      "enabled": false,
      "conditionMatch": "all",
      "recursionDepth": null,
      "conditions": [
        { "id": "c1", "ruleId": "contrato-locacao", "kind": "contents", "operator": "matches_regex", "value": "(?i)contrato\\s+de\\s+loca[cç][ãa]o" }
      ],
      "actions": [
        { "id": "a1", "ruleId": "contrato-locacao", "kind": "add_tag", "params": { "tags": ["locacao"] }, "position": 0 }
      ],
