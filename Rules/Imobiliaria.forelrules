    },
    {
      "id": "condominio",
      "folderId": "import",
      "name": "Boleto ou taxa de condomínio",
      "enabled": false,
      "conditionMatch": "all",
      "recursionDepth": null,
      "conditions": [
        { "id": "c1", "ruleId": "condominio", "kind": "contents", "operator": "matches_regex", "value": "(?i)(boleto|recibo|taxa)\\s+(de\\s+)?condom[íi]nio" }
      ],
      "actions": [
        { "id": "a1", "ruleId": "condominio", "kind": "add_tag", "params": { "tags": ["condominio"] }, "position": 0 }
      ],
